# Sao chép file này thành .env (khi chạy trên máy) rồi điền giá trị thật.
# Trên Vercel: điền các biến này ở Project → Settings → Environment Variables (đổi xong phải Redeploy).
# KHÔNG commit file .env lên GitHub.

# ===== Bắt buộc =====
# Chủ hệ thống: Gmail của bạn (cách nhau dấu phẩy nếu nhiều Owner). Đăng nhập bằng Gmail này là thành Owner.
# Cũng là đường cứu hộ: mất hết quyền Owner thì đặt biến này rồi đăng nhập lại.
OWNER_EMAILS=
# Khoá mã hoá quyền Google Lịch của người dùng (32 byte, base64). Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ĐỪNG ĐỔI sau khi có người dùng: đổi là mọi người phải kết nối lại Google Lịch. Production và Preview dùng khoá khác nhau.
TOKEN_ENC_KEY=
# Bảo vệ /api/cron (cron-job.org gọi /api/cron?key=<giá trị> mỗi 5 phút)
CRON_SECRET=

# ===== Lưu dữ liệu trên Vercel (tự có khi kết nối Upstash Redis trong tab Storage) =====
# Bắt buộc trên Vercel: tài khoản, lịch, việc, hàng lệnh, log bot lịch đều nằm ở đây.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Tiền tố khoá (khi nhiều web dùng chung một Upstash; đặt khác cho môi trường Preview: KV_PREFIX=qltg-preview:)
# KV_PREFIX=qltg:
# STORAGE_KEY=quanlythoigian:db

# ===== Tên miền chính =====
# Mọi trang chuyển về tên miền này. Bot Zalo (PyloS), webhook Zalo, cron vẫn gọi được ở tên miền cũ. Cũ gọi là APP_HOST (vẫn đọc).
# PRIMARY_HOST=iforgotmywayhome.vercel.app

# ===== Google (đăng nhập + Google Lịch) =====
# Thường nhập trên web: Quản lý bot lịch → Khoá & trạng thái. Xem README, mục "Google".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Gemini: lấy ở https://aistudio.google.com/apikey (hoặc nhập trên web)
GEMINI_API_KEY=
# Zalo Bot nhắc việc của web: tạo bot trong ứng dụng Zalo → "Zalo Bot Manager" (hoặc nhập trên web)
ZALO_BOT_TOKEN=

# ===== Tuỳ chọn =====
# Model Gemini (mặc định gemini-3.1-flash-lite: nhanh, dùng được gói miễn phí)
# GEMINI_MODEL=
# Múi giờ dùng để hiểu "hôm nay", "thứ 5 tuần sau"...
# APP_TIMEZONE=Asia/Ho_Chi_Minh
# Chuỗi bí mật webhook Zalo (để trống = tự sinh từ token)
# ZALO_WEBHOOK_SECRET=
# ID Zalo nhận nhắc việc (để trống = dùng tài khoản đã ghép nối bằng /ketnoi trên web)
# ZALO_CHAT_ID=
# Khi chạy trên máy: polling (tự hỏi Zalo, không cần tên miền) hoặc webhook
ZALO_MODE=polling
# Địa chỉ API của Zalo Bot (thường không cần đổi)
# ZALO_API_BASE=https://bot-api.zapps.me
# Cổng chạy web trên máy
PORT=3000
# Bao lâu đồng bộ nguồn / Google Lịch một lần (phút)
SYNC_INTERVAL_MINUTES=30
# Nhắc trước sự kiện bao nhiêu phút (bot Zalo nhắc việc, cho Owner chính)
REMIND_BEFORE_MINUTES=15
# Giờ gửi tóm tắt buổi sáng qua Zalo (0-23, để trống để tắt)
DAILY_SUMMARY_HOUR=7
