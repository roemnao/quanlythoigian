# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.

# Cổng chạy web
PORT=3000

# Mật khẩu bảo vệ web (khuyến nghị khi đưa lên mạng). Để trống = không cần đăng nhập.
# Tên đăng nhập bất kỳ, mật khẩu là giá trị dưới đây.
APP_PASSWORD=

# Múi giờ dùng để hiểu "hôm nay", "thứ 5 tuần sau"...
TZ=Asia/Ho_Chi_Minh

# ===== Gemini (Google AI Studio: https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Zalo Bot (tạo bot trong ứng dụng Zalo -> "Zalo Bot Manager" để lấy token) =====
ZALO_BOT_TOKEN=
# Địa chỉ API của Zalo Bot (thường không cần đổi)
ZALO_API_BASE=https://bot-api.zapps.me
# Chuỗi bí mật để xác thực webhook (tự đặt, 8-256 ký tự). Dùng khi chạy chế độ webhook.
ZALO_WEBHOOK_SECRET=
# webhook = Zalo gọi vào server của bạn (cần URL https công khai)
# polling = server tự hỏi Zalo tin nhắn mới (tiện khi chạy trên máy cá nhân)
ZALO_MODE=polling
# ID cuộc trò chuyện nhận nhắc việc. Nhắn "/id" cho bot để biết ID của bạn.
ZALO_CHAT_ID=

# ===== Tự động =====
# Bao lâu đồng bộ các nguồn một lần (phút)
SYNC_INTERVAL_MINUTES=30
# Nhắc trước sự kiện bao nhiêu phút
REMIND_BEFORE_MINUTES=15
# Giờ gửi tóm tắt buổi sáng qua Zalo (0-23, để trống để tắt)
DAILY_SUMMARY_HOUR=7
