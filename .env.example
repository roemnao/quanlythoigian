# Sao chép file này thành .env (khi chạy trên máy) rồi điền giá trị thật.
# Trên Vercel: điền các biến này ở Project → Settings → Environment Variables.
# KHÔNG commit file .env lên GitHub.

# ===== Bắt buộc =====
# Mật khẩu vào web (bắt buộc khi chạy trên Vercel)
APP_PASSWORD=
# Gemini: lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Zalo Bot: tạo bot trong ứng dụng Zalo → "Zalo Bot Manager" để lấy token
ZALO_BOT_TOKEN=

# ===== Lưu dữ liệu trên Vercel (tự có khi kết nối Upstash Redis trong tab Storage) =====
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===== Tuỳ chọn =====
# Model Gemini (mặc định gemini-3.1-flash-lite: nhanh, dùng được gói miễn phí)
# GEMINI_MODEL=
# Múi giờ dùng để hiểu "hôm nay", "thứ 5 tuần sau"...
# APP_TIMEZONE=Asia/Ho_Chi_Minh
# Bảo vệ đường dẫn /api/cron (nếu đặt, cron-job.org phải gọi /api/cron?key=<giá trị>)
# CRON_SECRET=
# Chuỗi bí mật webhook Zalo (để trống = tự sinh từ token)
# ZALO_WEBHOOK_SECRET=
# ID Zalo nhận nhắc việc (để trống = dùng tài khoản đã ghép nối bằng /ketnoi trên web)
# ZALO_CHAT_ID=
# Khi chạy trên máy: polling (tự hỏi Zalo, không cần tên miền) hoặc webhook
ZALO_MODE=polling
# Địa chỉ API của Zalo Bot (thường không cần đổi)
# ZALO_API_BASE=https://bot-api.zapps.me
# Cổng chạy web trên máy
PORT=3000
# Bao lâu đồng bộ các nguồn một lần (phút)
SYNC_INTERVAL_MINUTES=30
# Nhắc trước sự kiện bao nhiêu phút
REMIND_BEFORE_MINUTES=15
# Giờ gửi tóm tắt buổi sáng qua Zalo (0-23, để trống để tắt)
DAILY_SUMMARY_HOUR=7
